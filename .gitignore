# ---- 敏感凭证：绝不上传 ----
# 账号 JSON（明文 token）、面板/API Key 设置、区域状态
accounts/*
!accounts/README.txt

# 运行时数据：请求流水与指标快照
# 必须写成 /usage/（带前导斜杠 = 只锚定仓库根）：
# 不带斜杠的 `usage/` 会匹配**任意层级**同名目录，把前端路由
# web/app/(main)/usage/、web/components/common/usage/、web/out/usage/
# 一并忽略（git 不跟踪 + Tailwind 扫描器跳过 → 新页面样式整块丢失）。
/usage/

# ---- Python 运行产物 ----
__pycache__/
*.pyc
*.pyo

# ---- 测试临时数据目录 ----
tests/_acc/
tests/_use/

# ---- 前端（web/）：只忽略依赖与构建中间产物，web/out 产物必须入库 ----
web/node_modules/
web/.next/
web/tsconfig.tsbuildinfo

# ---- 本地工具 / 临时文件 ----
.mimosa/
_shots/
*.log
_tmp_*
.DS_Store
Thumbs.db

# ---- 内嵌便携 Python 运行时（可选，体积大；脚本会自动回退系统 Python）----
python/
